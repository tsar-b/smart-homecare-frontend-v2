# Optional while reviewing the interface; without it the app opens in preview mode.
# Use HTTPS outside development. Localhost, emulator loopback, and RFC1918 LAN
# HTTP hosts are accepted in development builds. An exact /api suffix is optional.
# Never place Supabase or backend secrets in this public Expo environment file.
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_API_TIMEOUT_MS=15000
# Keep false for a public build. Set true only when the backend's trusted
# booking-media pilot flag and provider-side cost controls are also enabled.
EXPO_PUBLIC_BOOKING_MEDIA_PILOT_UPLOADS=false

