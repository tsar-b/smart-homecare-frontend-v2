{
  "expo": {
    "name": "Smart HomeCare",
    "slug": "smart-homecare-app",
    "scheme": "smarthomecareapplication",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./asset/brand/app-icon-v2.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./asset/brand/splash-wordmark-v2.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F7FB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shc.appsmarthomecare",
      "buildNumber": "40",
      "appleTeamId": "V4K59G96Q4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesNonExemptEncryption": false
    },
    "android": {
      "package": "com.shc.smarthomecareapp",
      "versionCode": 40,
      "adaptiveIcon": {
        "foregroundImage": "./asset/brand/adaptive-foreground-v2.png",
        "backgroundColor": "#F5F7FB"
      }
    },
    "web": {
      "favicon": "./asset/brand/favicon-v2.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "useAndroidX": true,
            "enableJetifier": true
          },
          "gradleProperties": {
            "kotlinVersion": "2.0.21",
            "android.useAndroidX": "true",
            "android.enableJetifier": "true"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "고장 부위와 설치 환경 사진 또는 동영상을 예약에 첨부하려면 사진 보관함 접근이 필요합니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fe782eb9-d449-4468-bb1b-550a4c509458"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fe782eb9-d449-4468-bb1b-550a4c509458"
    }
  }
}
