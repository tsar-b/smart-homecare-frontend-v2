{
  "name": "smart-homecare-frontend-v2",
  "version": "2.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "check:backend": "node scripts/checkBackendConnection.mjs",
    "build:android-bundle": "expo export --platform android --output-dir .review-dist",
    "build:web-preview": "expo export --platform web --output-dir .review-web-dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-navigation/native": "^7.1.9",
    "@react-navigation/native-stack": "^7.3.13",
    "axios": "^1.20.0",
    "dayjs": "^1.11.13",
    "expo": "~53.0.27",
    "expo-clipboard": "~7.1.5",
    "expo-crypto": "~14.1.5",
    "expo-dev-client": "~5.2.4",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.1",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "~16.1.4",
    "expo-secure-store": "~14.2.4",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "expo-updates": "~0.28.18",
    "expo-video": "~2.2.2",
    "react": "^19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-toast-message": "^2.3.0",
    "react-native-web": "^0.20.0",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "eas-cli": "^23.2.0",
    "expo-build-properties": "~0.14.8",
    "typescript": "~5.8.3"
  },
  "private": true,
  "overrides": {
    "shell-quote": "^1.10.0"
